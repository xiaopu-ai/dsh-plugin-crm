{
  "schema": 1,
  "id": "powersports",
  "name": "动力运动",
  "pitch": "车主、车辆、保养维修工单、企微和 400 互动、经销商、试驾和俱乐部活动。默认值是假设，等业务方修改",
  "labels": { "customer": "客户", "transaction": "工单", "asset": "车辆", "touch": "互动", "lead": "线索", "campaign": "活动", "owner": "经销商" },
  "tableHints": [
    { "name": "车辆", "entities": ["customer", "asset"], "hint": "每辆车一行：车主姓名、手机、车架号（VIN）、车型、交车日期、保修到期日、经销商" },
    { "name": "工单", "entities": ["transaction"], "hint": "每张工单一行：工单号、车架号、进厂日期、类型（保养、维修、配件、精品、购车）、金额、经销商" },
    { "name": "互动", "entities": ["touch"], "hint": "企微加好友、400 来电、小程序、活动签到，每次一行：手机或企微 ID、渠道、日期、活动" },
    { "name": "活动", "entities": ["campaign"], "hint": "每个活动一行：名称、类型、开始、结束、预算" },
    { "name": "线索", "entities": ["lead"], "hint": "每条线索（销售机会、留资、活动报名）一行：线索编号、留资时间、级别或状态（热、温、冷、赢单、输单、休眠）、渠道来源、活动来源、意向车型、是否试驾、所属经销商、销售顾问、首次和最新跟进日期。没有手机号也能用；某场活动的报名表用同一套线索编号时也对成线索" }
  ],
  "columnHints": {
    "customer.name": ["车主", "车主姓名", "客户姓名", "姓名"],
    "customer.phone": ["手机", "车主手机", "联系电话"],
    "customer.consent": ["营销同意", "营销授权", "同意营销", "是否同意营销"],
    "customer.wechat": ["企微ID", "企业微信"],
    "asset.serial": ["车架号", "VIN"],
    "asset.model": ["车型"],
    "asset.start": ["交车日期", "开票日期"],
    "asset.end": ["保修到期", "保修到期日"],
    "asset.owner": ["经销商"],
    "transaction.orderNo": ["工单号", "单号"],
    "transaction.date": ["进厂日期", "结算日期"],
    "transaction.type": ["工单类型", "类型"],
    "transaction.amount": ["金额", "结算金额"],
    "touch.channel": ["渠道", "来源"],
    "touch.date": ["日期", "时间"],
    "touch.campaign": ["活动"],
    "campaign.name": ["活动名称", "名称"],
    "lead.id": ["线索编号", "机会编号", "ID"],
    "lead.date": ["留资日期", "留资时间", "单据生成日期", "创建日期"],
    "lead.result": ["机会级别", "线索状态", "状态"],
    "lead.level": ["机会级别", "意向级别"],
    "lead.channel": ["渠道来源", "线索来源"],
    "lead.source": ["首次活动来源", "来源明细"],
    "lead.campaign": ["市场活动名称", "关联市场活动"],
    "lead.product": ["意向产品系列", "意向车型", "意向产品型号"],
    "lead.trial": ["是否试乘试驾", "是否试驾"],
    "lead.owner": ["所属经销商", "经销商"],
    "lead.rep": ["销售顾问", "跟进人"],
    "lead.firstFollow": ["首次跟进日期"],
    "lead.lastFollow": ["最新跟进日期", "最近跟进日期"],
    "lead.wonDate": ["成交时间", "成交日期"]
  },
  "dictionaries": {
    "transaction.type": { "保养": ["保养", "首保", "定保"], "维修": ["维修", "保修维修"], "配件": ["配件"], "精品": ["精品", "装备"], "购车": ["购车", "新车"] },
    "touch.channel": { "企微": ["企微", "企业微信", "加好友"], "400": ["400", "400来电", "电话"], "小程序": ["小程序"], "活动签到": ["活动签到", "签到"], "抖音": ["抖音", "抖音留资"] },
    "lead.result": { "成交": ["成交", "赢单", "已转化", "已成交"], "战败": ["战败", "输单"], "休眠": ["休眠"], "跟进中": ["跟进中", "热", "温", "冷", "不确定", "未转化"] },
    "lead.trial": { "是": ["是", "Yes", "已试驾"], "否": ["否", "No", "未试驾"] }
  },
  "identity": [
    { "keys": ["asset.serial"], "strength": "strong" },
    { "keys": ["customer.idcard"], "strength": "strong" },
    { "keys": ["customer.phone"], "strength": "strong", "unless": "shared" },
    { "keys": ["customer.wechat"], "strength": "strong" },
    { "keys": ["customer.name", "customer.city"], "strength": "weak" }
  ],
  "measures": {
    "refunds": "net",
    "refundTypes": [],
    "excludeStatuses": [],
    "openStatuses": [],
    "sameDayDuplicates": "each",
    "staleStatus": "unknown",
    "note": "按工单结算金额算；同一天的两张工单各算一笔。"
  },
  "segments": [
    { "name": "潜客", "desc": "有互动（企微、400、抖音留资），还没买车", "all": [{ "feature": "asset_count", "op": "=", "value": 0 }, { "feature": "touch_count", "args": [3650], "op": ">=", "value": 1 }] },
    { "name": "活跃", "desc": "近 90 天有到店或交易", "all": [{ "feature": "days_since_last_txn", "args": [["保养", "维修", "配件", "精品"]], "op": "<=", "value": 90 }] },
    { "name": "新车主", "desc": "交车不到 90 天", "all": [{ "feature": "asset_age_days", "op": "<", "value": 90 }] },
    { "name": "沉睡", "desc": "91～365 天没有到店或交易", "any": [
      { "feature": "days_since_last_txn", "args": [["保养", "维修", "配件", "精品"]], "op": "between", "value": [91, 365] },
      { "all": [{ "feature": "has_txn", "args": [["保养", "维修", "配件", "精品"]], "op": "=", "value": false }, { "feature": "asset_age_days", "op": "between", "value": [90, 365] }] }
    ] },
    { "name": "流失风险", "desc": "超过 365 天没有任何记录", "any": [
      { "feature": "days_since_last_txn", "args": [["保养", "维修", "配件", "精品"]], "op": ">", "value": 365 },
      { "all": [{ "feature": "has_txn", "args": [["保养", "维修", "配件", "精品"]], "op": "=", "value": false }, { "feature": "asset_age_days", "op": ">", "value": 365 }] }
    ] }
  ],
  "flags": [
    { "name": "高价值", "all": [{ "feature": "amount", "args": [365], "op": ">=", "value": 30000 }] },
    { "name": "保修将到期", "all": [{ "feature": "asset_days_to_end", "op": "between", "value": [0, 60] }] }
  ],
  "lists": {
    "purposes": ["保修到期", "沉睡唤醒", "首保提醒", "投诉回访", "活动邀约", "线索跟进"],
    "followDays": 14,
    "outcomes": [
      { "code": "visit", "name": "到店", "kind": "success" },
      { "code": "booked", "name": "约了到店", "kind": "booked" },
      { "code": "nointerest", "name": "不感兴趣", "kind": "decline", "cooldownDays": 90 },
      { "code": "noreach", "name": "联系不上", "kind": "unreachable", "cooldownDays": 30 },
      { "code": "sold", "name": "已卖车", "kind": "transfer" },
      { "code": "stop", "name": "不要再联系", "kind": "leave" }
    ]
  },
  "leads": { "followDays": 2, "staleDays": 14, "activeDays": 90, "trialName": "试驾", "minGroup": 30 },
  "campaign": { "effectDays": 30, "minGroup": 30 },
  "privacy": { "summaryOnly": false, "showText": [] },
  "report": {
    "sections": [
      { "title": "一句话结论", "hint": "这个月车主最重要的一个变化" },
      { "title": "车主分层和流转", "hint": "各层人数，和上个月比哪一站变多了、为什么" },
      { "title": "经销商对比", "hint": "按经销商拆开的到店和金额，掉得最多的是谁" },
      { "title": "线索和转化", "hint": "新线索多少、跟进多快、试驾和成交多少，按渠道和经销商拆；成交率只在同一段时间里比" },
      { "title": "活动和名单效果", "hint": "参加和没参加的差别，只陈述数字" },
      { "title": "建议跟进", "hint": "该优先联系的人群和理由，每条对应一份名单" }
    ]
  }
}
