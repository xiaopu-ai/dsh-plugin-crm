  "measures": {
    "refunds": "net",
    "refundTypes": [],
    "excludeStatuses": [],
    "openStatuses": [],
    "sameDayDuplicates": "each",
    "staleStatus": "unknown",
    "note": "一台交付的车算一笔购车记录，试乘试驾车不算；交付单没有成交价，只按台数和人数看。交付单没覆盖到的老车主按客户表的「最近交付年月」算。销售机会按线索算：一条机会一条线索，活动报名表和它用同一套编号，不重复算。"
  },
  "segments": [
    {
      "name": "购车 3 个月内",
      "kind": "lifecycle",
      "desc": "最近一次交车在 90 天内",
      "any": [
        {
          "feature": "days_since_last_txn",
          "op": "<=",
          "value": 90
        },
        {
          "feature": "days_since_field",
          "args": [
            "extra.last_delivery"
          ],
          "op": "<=",
          "value": 90
        }
      ]
    },
    {
      "name": "购车 3～12 个月",
      "kind": "lifecycle",
      "desc": "最近一次交车在 91～365 天前",
      "any": [
        {
          "feature": "days_since_last_txn",
          "op": "between",
          "value": [
            91,
            365
          ]
        },
        {
          "feature": "days_since_field",
          "args": [
            "extra.last_delivery"
          ],
          "op": "between",
          "value": [
            91,
            365
          ]
        }
      ]
    },
    {
      "name": "购车 1～2 年",
      "kind": "lifecycle",
      "desc": "最近一次交车在 1～2 年前",
      "any": [
        {
          "feature": "days_since_last_txn",
          "op": "between",
          "value": [
            366,
            730
          ]
        },
        {
          "feature": "days_since_field",
          "args": [
            "extra.last_delivery"
          ],
          "op": "between",
          "value": [
            366,
            730
          ]
        }
      ]
    },
    {
      "name": "购车 2 年以上",
      "kind": "lifecycle",
      "desc": "最近一次交车超过 2 年",
      "any": [
        {
          "feature": "days_since_last_txn",
          "op": ">",
          "value": 730
        },
        {
          "feature": "days_since_field",
          "args": [
            "extra.last_delivery"
          ],
          "op": ">",
          "value": 730
        }
      ]
    },
    {
      "name": "有线索没购车",
      "kind": "never",
      "desc": "没有交车记录，有过销售机会（线索挂得上客户才有人）",
      "all": [
        {
          "feature": "has_txn",
          "op": "=",
          "value": false
        },
        {
          "feature": "field",
          "args": [
            "extra.last_delivery"
          ],
          "op": "=",
          "value": ""
        },
        {
          "feature": "lead_count",
          "args": [
            3650
          ],
          "op": ">=",
          "value": 1
        }
      ]
    },
    {
      "name": "没购车也没线索",
      "kind": "plain",
      "desc": "客户表里有档，没有交车记录，也没有销售机会",
      "all": [
        {
          "feature": "has_txn",
          "op": "=",
          "value": false
        },
        {
          "feature": "field",
          "args": [
            "extra.last_delivery"
          ],
          "op": "=",
          "value": ""
        }
      ]
    }
  ],
  "flags": [
    {
      "name": "首保将失效",
      "desc": "有一台车的首保权益还没用、60 天内失效（天数待确认）",
