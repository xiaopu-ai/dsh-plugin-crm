{
  "schema": 1,
  "id": "dealer-network",
  "name": "经销商网络运营（客户表 + 交付单 + 销售机会）",
  "pitch": "厂家或总代看经销商：一张全量客户表，加交付单、销售机会（和某场活动的报名表）。这几张表的列名对得上，就能一步起草配置，不用聊。天数门槛、哪些行不算都是假设，按自己的业务改",
  "labels": {
    "customer": "客户",
    "transaction": "购车记录",
    "asset": "车辆",
    "lead": "销售机会",
    "campaign": "市场活动",
    "owner": "经销商"
  },
  "tableHints": [
    {
      "name": "客户",
      "entities": [
        "customer",
        "owner"
      ],
      "hint": "全量客户表，每个客户一行（同一个人在两家经销商建过档就是两行、两个客户编号）。「购买产品线」「外呼结果」一格里可以有几个值，当多值标签；「最近交付年月」用来兜住交付单没覆盖到的老车主。「大区」是经销商所在的大区（北区、中区、南区、退网、待开业），是经销商的属性，不是客户的。同一个人的重复建档：表里有联系电话时插件按电话自动合并，不要用行过滤去掉它们（交付单还指着这些客户）。",
      "table": {
        "mode": "snapshot",
        "optional": [
          "联系电话"
        ],
        "entities": {
          "customer": {
            "id": "客户编号",
            "name": "客户姓名",
            "phone": "联系电话",
            "city": "城市",
            "owner": "经销商代码"
          },
          "owner": {
            "id": "经销商代码",
            "name": "经销商简称"
          }
        },
        "extra": [
          {
            "entity": "customer",
            "key": "cust_type",
            "name": "客户类别",
            "column": "客户类别",
            "type": "category"
          },
          {
            "entity": "customer",
            "key": "province",
            "name": "省份",
            "column": "省份",
            "type": "category"
          },
          {
            "entity": "customer",
            "key": "last_delivery",
            "name": "最近交付年月",
            "column": "最近交付年月",
            "type": "date"
          },
          {
            "entity": "customer",
            "key": "product_line",
            "name": "购买产品线",
            "column": "购买产品线",
            "type": "tags"
          },
          {
            "entity": "customer",
            "key": "unit_count",
            "name": "历史购买台数",
            "column": "历史购买台数",
            "type": "number"
          },
          {
            "entity": "customer",
            "key": "wechat_status",
            "name": "企微建联",
            "column": "企微添加状态",
            "type": "category"
          },
          {
            "entity": "customer",
            "key": "call_result",
            "name": "外呼结果",
            "column": "外呼结果",
            "type": "tags"
          },
          {
            "entity": "customer",
            "key": "app_since",
            "name": "小程序注册",
            "column": "小程序注册日期",
            "type": "date"
          },
          {
            "entity": "customer",
            "key": "member_since",
            "name": "会员",
            "column": "会员开通日期",
            "type": "date"
          },
          {
            "entity": "owner",
            "key": "region",
            "name": "大区",
            "column": "大区",
            "type": "category"
          }
        ]
      }
    },
    {
      "name": "交付单",
      "entities": [
        "transaction",
        "asset",
        "owner"
      ],
      "hint": "交付单，每台交付的车一行，既是一笔购车记录，也是车主名下的一台车。「终端客户」形如「C000123 张三」，按空格切开第 1 段就是客户编号；「经销商」形如「D012 某某公司」，第 1 段是经销商代码。没有成交价，金额类指标不启用。「首保权益状态」「首保生效日期」「首保失效日期」是首保权益。「用途」是「试乘试驾」的是试驾车，不是卖出去的，默认不读。",
      "table": {
        "mode": "snapshot",
        "optional": [
          "车架号"
        ],
        "entities": {
          "transaction": {
            "orderNo": "交付单号",
            "date": "交付日期",
            "type": "产品线",
            "customerId": {
              "column": "终端客户",
              "split": " ",
              "part": 1
            },
            "owner": {
              "column": "经销商",
              "split": " ",
              "part": 1
            }
          },
          "asset": {
            "id": "交付单号",
            "serial": "车架号",
            "type": "产品线",
            "model": "车型",
            "start": "交付日期",
            "end": "保修到期日",
            "status": "首保权益状态",
            "customerId": {
              "column": "终端客户",
              "split": " ",
              "part": 1
            },
            "owner": {
              "column": "经销商",
              "split": " ",
              "part": 1
            }
          },
          "owner": {
            "id": {
              "column": "经销商",
              "split": " ",
              "part": 1
            },
            "name": {
              "column": "经销商",
              "split": " ",
              "part": -1
            }
          }
        },
        "extra": [
          {
            "entity": "transaction",
            "key": "unit_usage",
            "name": "用途",
            "column": "用途",
            "type": "category"
          },
          {
            "entity": "asset",
            "key": "model_year",
            "name": "年款",
            "column": "年款",
            "type": "category"
          },
          {
            "entity": "asset",
            "key": "benefit_start",
            "name": "首保生效日期",
            "column": "首保生效日期",
            "type": "date"
          },
          {
            "entity": "asset",
            "key": "benefit_end",
            "name": "首保失效日期",
            "column": "首保失效日期",
            "type": "date"
          }
        ],
        "skipRows": [
          {
            "column": "用途",
            "when": "in",
            "values": [
              "试乘试驾"
            ],
            "why": "试乘试驾车，不是卖出去的"
          }
        ]
      }
    },
    {
      "name": "销售机会",
      "entities": [
        "lead",
        "owner"
      ],
      "hint": "销售机会，每条线索一行，喂给线索，不要当互动，也不要当第二张客户表。「机会级别」既是级别也带结果：赢单是成交，输单是战败，休眠是休眠，热、温、冷、不确定是跟进中。「所属经销商」形如「D012 某某公司」，第 1 段是经销商代码。「区域经理」是这家经销商的区域经理，是经销商的属性。导出里没有手机号时线索挂不上客户，漏斗照样能算；有手机号时会按手机号挂到客户身上。",
      "table": {
        "mode": "snapshot",
        "optional": [
          "手机号"
        ],
        "entities": {
          "lead": {
            "id": "线索编号",
            "date": "创建日期",
            "customerName": "客户称呼",
            "customerPhone": "手机号",
            "result": "机会级别",
            "level": "机会级别",
            "channel": "渠道来源",
            "source": "来源明细",
            "campaign": "市场活动",
            "product": "意向产品",
            "trial": "是否试驾",
            "owner": {
              "column": "所属经销商",
              "split": " ",
              "part": 1
            },
            "rep": "销售顾问",
            "firstFollow": "首次跟进日期",
            "lastFollow": "最新跟进日期"
          },
          "owner": {
            "id": {
              "column": "所属经销商",
              "split": " ",
              "part": 1
            },
            "name": {
              "column": "所属经销商",
              "split": " ",
              "part": -1
            }
          }
        },
        "extra": [
          {
            "entity": "owner",
            "key": "dsm",
            "name": "区域经理",
            "column": "区域经理",
            "type": "category"
          }
        ]
      }
    },
    {
      "name": "活动报名",
      "optional": true,
      "entities": [
        "lead"
      ],
      "hint": "某一场活动的报名表，是销售机会的子集，用的是同一套线索编号：也喂给线索、对同一个线索编号，插件按编号合成一条，不会算两遍，在线索页能按「来自哪张表」单看这场活动。日期列叫「留资日期」。没有这张表也行。",
      "table": {
        "mode": "snapshot",
        "optional": [
          "手机号"
        ],
        "entities": {
          "lead": {
            "id": "线索编号",
            "date": "留资日期",
            "customerName": "客户称呼",
            "customerPhone": "手机号",
            "result": "机会级别",
            "level": "机会级别",
            "channel": "渠道来源",
            "source": "来源明细",
            "product": "意向产品",
            "trial": "是否试驾",
            "owner": {
              "column": "所属经销商",
              "split": " ",
              "part": 1
            },
            "firstFollow": "首次跟进日期",
            "lastFollow": "最新跟进日期"
          }
        }
      }
    }
  ],
