  "report": {
    "sections": [
      {
        "title": "一句话结论",
        "hint": "这段时间最重要的一个变化"
      },
      {
        "title": "线索和成交",
        "hint": "新线索多少、跟得快不快、成交多少，和前一段比；按渠道拆开哪里好哪里差"
      },
