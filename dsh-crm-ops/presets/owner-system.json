    },
    {
      "name": "战败",
      "desc": "还没有车，上一次购买意向没成",
      "all": [
        {
          "feature": "asset_count",
          "op": "=",
          "value": 0
        },
        {
          "feature": "field",
          "args": [
            "extra.stage"
          ],
          "op": "=",
          "value": "战败"
        }
      ]
    },
    {
      "name": "潜客",
      "desc": "还没有车，也没有购买意向记录",
      "all": [
        {
          "feature": "asset_count",
          "op": "=",
          "value": 0
        }
      ]
    },
    {
      "name": "新车主",
      "desc": "交车不到 90 天（待确认）",
      "all": [
        {
          "feature": "asset_age_days",
          "op": "<",
          "value": 90
        }
      ]
    },
    {
      "name": "活跃车主",
      "desc": "近 180 天有服务或互动（待确认）",
      "any": [
        {
          "feature": "days_since_last_txn",
          "op": "<=",
          "value": 180
        },
        {
          "feature": "days_since_last_touch",
          "op": "<=",
          "value": 180
        }
      ]
    },
    {
      "name": "沉睡车主",
      "desc": "180 天没有服务也没有互动，和原系统的「沉睡」口径一致（待确认）",
      "all": [
        {
          "feature": "asset_count",
          "op": ">=",
          "value": 1
        }
      ]
    }
  ],
  "flags": [
    {
      "name": "该做首保",
      "desc": "原系统按产品线的首保规则算出来该提醒（规则待确认）",
