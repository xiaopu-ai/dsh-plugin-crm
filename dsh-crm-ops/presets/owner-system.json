  "segments": [
    {
      "name": "新线索",
      "desc": "还没有车，购买意向刚建、还没联系",
      "all": [
        {
          "feature": "asset_count",
          "op": "=",
          "value": 0
        },
        {
          "feature": "field",
          "args": [
            "extra.stage"
          ],
          "op": "=",
          "value": "新线索"
        }
      ]
    },
    {
      "name": "已联系",
      "desc": "还没有车，已经联系上",
      "all": [
        {
          "feature": "asset_count",
          "op": "=",
          "value": 0
        },
        {
          "feature": "field",
          "args": [
            "extra.stage"
          ],
          "op": "=",
