{
  "schema": 1,
  "id": "owner-system",
  "name": "车主管理系统导出（不带姓名手机号）",
  "pitch": "接车主管理系统的分析导出：客户、车辆、服务记录、互动、活动。表里没有姓名和手机号，按客户编号认人；要联系人，拿名单里的客户编号回原系统申请导出。分层天数等默认值是假设，按自己的业务改",
  "labels": {
    "customer": "客户",
    "transaction": "服务记录",
    "asset": "车辆",
    "touch": "互动",
    "campaign": "活动",
    "owner": "门店"
  },
  "tableHints": [
    {
      "name": "客户",
      "entities": [
        "customer"
      ],
      "hint": "每个客户一行：客户编号、客户类型（个人、运营、机构）、城市、服务门店、营销同意（同意、拒绝、撤回，空着是没记录）、建档日期。没有姓名和手机号。后面六列对成自定义字段，key 要照这里写，分层和标记才用得上：售前阶段 → stage（类别）；首保提醒 → remind_first、保养提醒 → remind_periodic、季前检查提醒 → remind_preseason、季末封存提醒 → remind_storage（都是类别，原系统按自己的售后规则算好，该提醒就写「是」）；驾驶证到期 → licence_end（日期）。客户类型可以对成 ctype（类别）"
    },
    {
      "name": "车辆",
      "entities": [
        "asset"
      ],
      "hint": "每辆车一行，只含现在的车主：客户编号、车架号、车型、产品线（水上、公路、越野、冰雪）、品牌、交车日期、保修到期、销售门店。车架号这一列里有 17 位车架号，也有 12 位艇身号（摩托艇），按普通编号读，不要按 VIN 校验"
    },
    {
      "name": "服务记录",
      "entities": [
        "transaction"
      ],
      "hint": "每次服务一行，作废的不导出：记录编号、客户编号、车架号、服务日期、服务类型（首保、定期保养、季前检查、季末封存、维修、保修维修）、门店。没有金额"
    },
    {
      "name": "互动",
      "entities": [
        "touch"
      ],
      "hint": "每次跟进或活动签到一行：客户编号、渠道（电话、微信、到店、试驾、活动签到、售后、其他）、日期、活动（只有活动签到才填）。不带跟进内容"
    },
    {
      "name": "活动",
      "entities": [
        "campaign"
      ],
      "hint": "每个活动一行：活动名称、类型、开始、结束、预算"
    }
  ],
