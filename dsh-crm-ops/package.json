{
  "name": "@xiaopuai/dsh-crm-ops",
  "version": "0.13.0",
  "private": true,
  "description": "客户运营台：把几个系统导出的客户表和交易表导进来，插件自己清洗、合并、分层，AI 问清业务、写结论。数据都在本机。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "license": "MIT",
  "author": "xiaopu-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaopu-ai/dsh-plugin-crm.git",
    "directory": "dsh-crm-ops"
  },
  "homepage": "https://github.com/xiaopu-ai/dsh-plugin-crm#readme",
  "bugs": {
    "url": "https://github.com/xiaopu-ai/dsh-plugin-crm/issues"
  },
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./config": "./lib/host/config.js",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./analyst": "./lib/host/analyst.js",
    "./assistant": "./lib/host/assistant.js",
    "./presets/crm-assistant.patch.yml": "./presets/crm-assistant.patch.yml"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "web": "node tools/start.mjs",
    "pack": "node tools/pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/crm-assistant.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.2",
    "pnpm": "11.5.1"
  }
}
